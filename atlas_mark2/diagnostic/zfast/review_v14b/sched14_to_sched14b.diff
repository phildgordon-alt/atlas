+/* m3: one checked append per line; F_FULLFSYNC (fallback fsync), checked, at most once per second (group commit) and at the end of the
+   session (ck_sync(Q, 1)).  A crash or power loss can lose at most the unsynced tail, which is torn/missing and recomputed on resume. */
+static void ck_sync(wq_t *Q, int force)
+{
+    if (Q->fd < 0) return;
+    double t = now();
+    if (!force && t - Q->last_sync < 1.0) return;
+    if (fcntl(Q->fd, F_FULLFSYNC) == -1 && fsync(Q->fd) != 0)
+    { zf14b_seterr("checkpoint fsync failed (%s); checkpointing stopped, the session continues", strerror(errno)); Q->werr++; close(Q->fd); Q->fd = -1; return; }
+    Q->last_sync = t; Q->syncs++;
+}
+static void ck_write(wq_t *Q, const char *s, size_t n)
+{
+    if (Q->fd < 0) return;
+    size_t off = 0;
+    while (off < n)
+    {
+        ssize_t r = write(Q->fd, s + off, n - off);
+        if (r < 0 && errno == EINTR) continue;
+        if (r <= 0) { zf14b_seterr("checkpoint write failed (%s); checkpointing stopped, the session continues", r < 0 ? strerror(errno) : "short write"); Q->werr++; close(Q->fd); Q->fd = -1; return; }
+        off += (size_t)r;
+    }
+    Q->written++;
+    ck_sync(Q, 0);
+}
