+def _gen_pid(run):
+    q = subprocess.run(['pgrep', '-f', f'gen_target5.py {run}'], capture_output=True, text=True).stdout.split()
+    return int(q[0]) if q else None
+
+
+def _stages(run):
+    return [json.loads(l).get('stage') for l in open(run / 'gen.jsonl') if l.strip()] if (run / 'gen.jsonl').exists() else []
+
+
+def _kill_when(dst, name, T0, lo, hi, ext, cond, limit=1800):
+    """start the pipeline, SIGKILL its generator as soon as cond(run) holds; returns (popen rc, killed pid, stages at kill)"""
+    run = dst / 'runs' / f'w{T0}' / name
+    p = _pipeline(dst, name, T0, lo, hi, ext, log='kill', popen=True); t0 = time.time(); killed = None; st = None
+    while p.poll() is None and time.time() - t0 < limit:
+        if cond(run):
+            pid = _gen_pid(run)
+            if pid: os.kill(pid, signal.SIGKILL); killed = pid; st = _stages(run); break
+        time.sleep(0.02)
+    p.wait()
+    return p.returncode, killed, st
+
+
+def _sc(run):
+    f = run / 'zfast_ckpt_gen.txt.sessions.jsonl'
+    return [json.loads(l) for l in open(f)] if f.exists() else []
+
